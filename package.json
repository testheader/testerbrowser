{
  "name": "testerbrowser",
  "productName": "TesterBrowser",
  "version": "0.1.0",
  "description": "A Chromium-based desktop browser purpose-built for software testers: isolated multi-sessions with always-on network/console recording.",
  "main": "dist/main/index.js",
  "author": "Your Org",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish always",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish always",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0",
    "@types/better-sqlite3": "^7.6.10"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.testerbrowser.app",
    "productName": "TesterBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "publish": {
      "provider": "github",
      "owner": "testheader",
      "repo": "testerbrowser"
    }
  }
}
